# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — .env.example is the template that gets committed.

POSTGRES_USER=nlp_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nlp_project

PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=change_me

# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_string

TEACHER_EMAIL=teacher@college.edu
TEACHER_PASSWORD=change_me
TEACHER_NAME=Default Teacher

VITE_API_URL=http://localhost:8000

# Optional: enables AI-generated new topics (/topics/generate). Without it an offline template fallback is used.
GEMINI_API_KEY=
